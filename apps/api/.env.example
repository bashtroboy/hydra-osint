# HYDRA API Server Environment Configuration

# HTTP port
PORT=3000

# PostgreSQL connection URL (with PostGIS / TimescaleDB)
DATABASE_URL=postgres://hydra:hydra@localhost:5432/hydra

# Redis connection URL (used by BullMQ and rate limiting)
REDIS_URL=redis://localhost:6379

# Secret for signing JWT tokens — CHANGE IN PRODUCTION
JWT_SECRET=change-me-in-production

# Runtime environment: development | production | test
NODE_ENV=development

# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
